<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RegistrationAdmin.App</RootNamespace>
    <AssemblyName>RegistrationAdmin</AssemblyName>
    <AssemblyTitle>活動報名後台</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 程式圖示（由 assets\icon\make_icon.py 產生）；exe、捷徑、工作列都用這個 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>zh-Hant;zh-TW</SatelliteResourceLanguages>
    <!-- 自訂 Main：讓 Velopack 先處理安裝／更新事件（見 Program.cs） -->
    <StartupObject>RegistrationAdmin.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="..\..\docs\manual\使用手冊.md" LogicalName="RegistrationAdmin.App.Help.UserManual.md" />
    <Resource Include="..\..\docs\manual\images\*.png" Link="Help\images\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 隨程式發佈的 OAuth 用戶端（Desktop app 類型）。檔案不進版控，見 .gitignore。 -->
    <None Include="..\..\config\google-oauth-client.json" Link="google-oauth-client.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\config\google-oauth-client.json')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RegistrationAdmin.Core\RegistrationAdmin.Core.csproj" />
    <ProjectReference Include="..\RegistrationAdmin.GoogleSheets\RegistrationAdmin.GoogleSheets.csproj" />
    <ProjectReference Include="..\RegistrationAdmin.Export\RegistrationAdmin.Export.csproj" />
  </ItemGroup>
</Project>

<UserControl x:Class="RegistrationAdmin.App.Views.RegistrationListView" SizeChanged="OnSizeChanged"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- 狀態標籤：色調＋文字 -->
    <DataTemplate x:Key="StatusChip">
      <Border Style="{StaticResource Chip}" Background="{Binding StatusTone, Converter={StaticResource ToneBackground}}">
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Status}" Foreground="{Binding StatusTone, Converter={StaticResource ToneForeground}}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MembershipChip">
      <Border Style="{StaticResource Chip}" Background="{Binding MembershipTone, Converter={StaticResource ToneBackground}}">
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Membership}" Foreground="{Binding MembershipTone, Converter={StaticResource ToneForeground}}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="PaymentChip">
      <Border Style="{StaticResource Chip}" Background="{Binding PaymentTone, Converter={StaticResource ToneBackground}}">
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding Payment}" Foreground="{Binding PaymentTone, Converter={StaticResource ToneForeground}}" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="24,20,24,0" MaxWidth="1440">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 頁首：活動名稱與唯一主要動作 -->
    <DockPanel Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Margin="16,0,0,0"
              Command="{Binding RefreshCommand}" ToolTip="從 Google 試算表讀取最新報名（F5）" AutomationProperties.Name="更新名單">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" />
          <TextBlock Text="更新名單" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding EventTitle}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
          <Run Text="{Binding EventSubtitle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastUpdatedText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- 摘要卡（4 張） -->
    <ItemsControl x:Name="CardsPanel" Grid.Row="1" ItemsSource="{Binding Cards}" Margin="-8,0,-8,16" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,14">
            <StackPanel>
              <TextBlock Text="{Binding Title}" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0" />
              <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 名單 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="ListHeader" Margin="20,16,20,0">
          <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ListTitle}" />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding ListSubtitle}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 搜尋與快速篩選 -->
        <Grid Grid.Row="1" Margin="20,14,20,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="560" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" AutomationProperties.Name="搜尋報名"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="搜尋姓名、Email、電話、單位或報名編號（Ctrl+F）" Foreground="{StaticResource PlaceholderBrush}" FontSize="15"
                       VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"
                       Visibility="{Binding Keyword, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
          </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="20,0,20,12">
          <WrapPanel>
            <RadioButton Style="{StaticResource FilterPill}" GroupName="Quick" Content="待處理" Margin="0,0,8,6"
                         IsChecked="{Binding QuickFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Pending}" />
            <RadioButton Style="{StaticResource FilterPill}" GroupName="Quick" Content="全部" Margin="0,0,8,6"
                         IsChecked="{Binding QuickFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
            <RadioButton Style="{StaticResource FilterPill}" GroupName="Quick" Content="有錯誤" Margin="0,0,8,6"
                         IsChecked="{Binding QuickFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Errors}" />
            <RadioButton Style="{StaticResource FilterPill}" GroupName="Quick" Content="疑似重複" Margin="0,0,8,6"
                         IsChecked="{Binding QuickFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Duplicates}" />
            <ToggleButton Style="{StaticResource ToggleOutline}" Margin="4,0,0,6" IsChecked="{Binding ShowMoreFilters}"
                          AutomationProperties.Name="更多篩選">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding MoreFiltersLabel}" />
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="8,2,0,0" />
              </StackPanel>
            </ToggleButton>
          </WrapPanel>

          <!-- 進階篩選：預設收合 -->
          <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="10"
                  Padding="16,12" Margin="0,6,0,0" Visibility="{Binding ShowMoreFilters, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
              <StackPanel Margin="0,0,16,8" Width="150">
                <TextBlock Style="{StaticResource FieldLabel}" Text="報名狀態" />
                <ComboBox ItemsSource="{Binding Options.FilterRegistrationStatuses}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterRegistrationStatus}" AutomationProperties.Name="報名狀態篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" Width="140">
                <TextBlock Style="{StaticResource FieldLabel}" Text="會員" />
                <ComboBox ItemsSource="{Binding Options.FilterMembershipStatuses}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterMembershipStatus}" AutomationProperties.Name="會員篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" Width="140">
                <TextBlock Style="{StaticResource FieldLabel}" Text="資格" />
                <ComboBox ItemsSource="{Binding Options.FilterEligibilityStatuses}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterEligibilityStatus}" AutomationProperties.Name="資格篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" Width="140">
                <TextBlock Style="{StaticResource FieldLabel}" Text="付款" />
                <ComboBox ItemsSource="{Binding Options.FilterPaymentStatuses}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterPaymentStatus}" AutomationProperties.Name="付款篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" Width="120">
                <TextBlock Style="{StaticResource FieldLabel}" Text="發票" />
                <ComboBox ItemsSource="{Binding Options.FilterInvoiceStatuses}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterInvoiceStatus}" AutomationProperties.Name="發票篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" Width="120">
                <TextBlock Style="{StaticResource FieldLabel}" Text="午餐" />
                <ComboBox ItemsSource="{Binding Options.FilterMealCodes}" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding FilterMealCode}" AutomationProperties.Name="午餐篩選" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom" Orientation="Horizontal">
                <CheckBox Content="包含已封存" IsChecked="{Binding IncludeArchived}" Margin="0,0,12,0" />
                <Button Style="{StaticResource TextButton}" Content="清除篩選" Command="{Binding ClearFiltersCommand}" />
              </StackPanel>
            </WrapPanel>
          </Border>
        </StackPanel>

        <!-- 表格：點整列開啟 -->
        <DataGrid x:Name="Grid" Grid.Row="3" Style="{StaticResource ListGrid}"
                  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutomationProperties.Name="報名名單" PreviewKeyDown="OnGridKeyDown">
          <DataGrid.Resources>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
              <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
            </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="報名者" Width="2*" MinWidth="170" SortMemberPath="Name" CanUserSort="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubLine}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="單位" Width="1.8*" MinWidth="110" SortMemberPath="Organization" CanUserSort="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Organization}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Organization}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="報名狀態" Width="1.3*" MinWidth="110" SortMemberPath="Status" CanUserSort="True"
                                    CellTemplate="{StaticResource StatusChip}" />
            <DataGridTemplateColumn Header="會員" Width="1.1*" MinWidth="96" SortMemberPath="Membership" CanUserSort="True"
                                    CellTemplate="{StaticResource MembershipChip}" />
            <DataGridTemplateColumn Header="付款" Width="1.2*" MinWidth="116" SortMemberPath="Payment" CanUserSort="True"
                                    CellTemplate="{StaticResource PaymentChip}" />
            <DataGridTemplateColumn Header="問題" Width="1.6*" MinWidth="130" SortMemberPath="ProblemSummary" CanUserSort="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding ProblemDetail}">
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding ProblemSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProblems}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                              <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- 空清單說明 -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48,24,24" MaxWidth="460"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
          <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
          <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>

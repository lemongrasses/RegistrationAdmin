<UserControl x:Class="RegistrationAdmin.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="clr-namespace:RegistrationAdmin.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32" VerticalAlignment="Center">
      <Border Style="{StaticResource Card}" MaxWidth="520" Padding="36" HorizontalAlignment="Center">
        <StackPanel>
          <Image Source="/RegistrationAdmin;component/Assets/app.ico" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,20" />
          <TextBlock Text="活動報名後台" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="先登入，再開始處理報名" FontSize="18" Margin="0,10,0,0" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,24" TextWrapping="Wrap"
                     Text="請使用有報名試算表編輯權限的 Google 帳號。登入成功後，才能設定試算表、查看名單與匯出資料。" />
          <Button Content="登入 Google" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"
                  MinHeight="46" AutomationProperties.Name="登入 Google，進入活動報名後台" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" BorderThickness="0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,14,0,0"
                     Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Content="取消登入" Command="{Binding CancelLoginCommand}" Margin="0,10,0,0"
                  Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0" TextWrapping="Wrap"
                     Text="首次登入會開啟 Windows 預設瀏覽器，帳號與密碼請在 Google 頁面輸入。已有有效授權時，按登入即可繼續。" />
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                     Text="已登入時會自動進入後台。未登入或授權失效時才會顯示此封面；登入失敗可取消後重試。" />
          <Button Content="更換帳號／清除保存的登入" Command="{Binding SignOutCommand}" Style="{StaticResource TextButton}"
                  HorizontalAlignment="Left" Margin="-8,8,0,0" />
          <Expander Header="登入設定（維護者）" Margin="0,14,0,0">
            <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="只有登入設定檔缺漏時才需要更改。請使用維護人員提供的 Google OAuth 用戶端 JSON。" />
              <TextBox Text="{Binding ClientSecretPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Google OAuth 用戶端檔案" />
              <Button Content="選擇登入設定檔…" Command="{Binding BrowseClientSecretCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Expander>
          <DockPanel Margin="0,24,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button Content="使用手冊（F1）" Style="{StaticResource TextButton}" Command="{x:Static help:HelpCommands.Open}"
                    CommandParameter="1" HorizontalAlignment="Left" Margin="-8,0,0,0" />
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>

<Window x:Class="RegistrationAdmin.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用手冊 — 活動報名後台" Icon="/RegistrationAdmin;component/Assets/app.ico"
        Width="1040" Height="760" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}">
  <DockPanel Margin="20" Background="{StaticResource PageBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="關閉" Click="CloseHelp" ToolTip="關閉說明（Esc）" />
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="使用手冊" />
        <TextBlock Style="{StaticResource Muted}" Text="離線可閱讀。選擇章節或搜尋內容；說明不會變更目前的報名資料。" Margin="0,4,12,0" />
      </StackPanel>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="搜尋章節或內容" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchChanged" Margin="0,0,0,10"
                 AutomationProperties.Name="搜尋使用手冊" />
        <TextBlock x:Name="NoResults" DockPanel.Dock="Bottom" Text="找不到符合的章節，請換個關鍵字。"
                   TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,12,0,0" />
        <ListBox x:Name="ChapterList" SelectionChanged="ChapterChanged"
                 AutomationProperties.Name="使用手冊章節" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /></DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,10" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <FlowDocumentScrollViewer x:Name="Reader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="使用手冊內容" />
      </Border>
    </Grid>
  </DockPanel>
</Window>

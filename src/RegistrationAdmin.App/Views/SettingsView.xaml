<UserControl x:Class="RegistrationAdmin.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/RegistrationAdmin;component/Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24,20,24,96" MaxWidth="960" HorizontalAlignment="Left">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource HelpButton}" CommandParameter="1" />
        <TextBlock Style="{StaticResource PageTitle}" Text="設定" />
      </DockPanel>
      <TextBlock Style="{StaticResource Muted}" Text="一般使用者通常只需要確認連線狀態。" Margin="0,4,0,16" />

      <Border Background="{StaticResource InfoBannerBrush}" BorderBrush="{StaticResource InfoBannerBorderBrush}" BorderThickness="1" CornerRadius="10"
              Padding="14,10" Margin="0,0,0,16" Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}"
              AutomationProperties.LiveSetting="Polite">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{Binding CancelOperationText}" Command="{Binding CancelLoginCommand}" Margin="12,0,0,0"
                  Visibility="{Binding CanCancelOperation, Converter={StaticResource BoolToVisibility}}" />
          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="48" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource DividerBrush}" BorderThickness="0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- 第一次使用 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="開始使用" />
          <TextBlock Style="{StaticResource Hint}" Text="您已登入 Google。完成試算表設定後，之後從封面登入就會自動連線。" />
          <TextBlock Style="{StaticResource GroupTitle}" Text="1　選擇報名資料試算表" />
          <Button Content="選擇試算表…" Command="{Binding PickSpreadsheetCommand}" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource Hint}" Text="在 Windows 預設瀏覽器的 Google 選擇器中，使用相同帳號選擇有編輯權限的表單回應試算表；也可以貼上網址。" />
          <TextBox Text="{Binding SpreadsheetInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="報名資料試算表網址"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          <TextBlock Style="{StaticResource Hint}" Text="在瀏覽器開啟 Google Form 的「回應」試算表，複製網址列整段貼上。" />
          <TextBlock Style="{StaticResource GroupTitle}" Text="2　連線報名資料" />
          <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="連線試算表" Command="{Binding ConnectCommand}" />
          <TextBlock Style="{StaticResource Hint}" Text="會檢查試算表與管理分頁。若目前帳號沒有編輯權限，請使用「重新連線」返回封面更換帳號。" />
        </StackPanel>
      </Border>

      <!-- Google 連線 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Google 連線" />
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SettingLabel}" Text="Google 帳號" />
            <WrapPanel Grid.Column="1">
              <Border Style="{StaticResource Chip}" Background="{Binding ConnectionTone, Converter={StaticResource ToneBackground}}" Margin="0,0,10,0">
                <TextBlock Style="{StaticResource ChipText}" Text="{Binding ConnectionLabel}" Foreground="{Binding ConnectionTone, Converter={StaticResource ToneForeground}}" />
              </Border>
              <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource SettingLabel}" Text="報名資料" Margin="0,12,16,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap">
              <Run Text="{Binding SpreadsheetTitle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="（Google 試算表）" Foreground="{StaticResource MutedBrush}" />
            </TextBlock>
          </Grid>
          <WrapPanel Margin="0,18,0,0" Visibility="{Binding NeedsSetup, Converter={StaticResource InverseBoolToVisibility}}">
            <Button Content="選擇試算表…" Command="{Binding PickSpreadsheetCommand}" Margin="0,0,8,0"
                    ToolTip="開啟 Google 選擇器；選取後需按連線確認。取消時保留原本設定。" />
            <Button Style="{StaticResource PrimaryButton}" Content="連線試算表" Command="{Binding ConnectCommand}" Margin="0,0,8,0"
                    ToolTip="重新讀取試算表並更新名單" />
            <Button Content="重新連線" Command="{Binding ReconnectCommand}" ToolTip="重新登入 Google，可以換成其他帳號" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 資料保護 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <WrapPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="資料保護" Margin="0,0,10,0" />
            <Border Style="{StaticResource Chip}" Background="{StaticResource SuccessChipBrush}">
              <TextBlock Style="{StaticResource ChipText}" Text="原始回應保持唯讀" Foreground="{StaticResource SuccessChipTextBrush}" />
            </Border>
          </WrapPanel>
          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                     Text="程式只讀取 Google Form 原始回應；後台狀態與備註會寫入同一份試算表中獨立的管理分頁。" />
          <TextBlock Text="{Binding HealthText}" Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HealthOk}" Value="False" />
                      <Condition Binding="{Binding IsConnected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- 進階（管理員） -->
      <Button HorizontalAlignment="Left" Command="{Binding ToggleAdvancedCommand}" AutomationProperties.Name="進階（管理員）">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="進階（管理員）" />
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="&#xE70D;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAdvancedOpen}" Value="True">
                    <Setter Property="Text" Value="&#xE70E;" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>

      <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Background="{StaticResource WarningBannerBrush}" BorderBrush="{StaticResource WarningBannerBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
          <TextBlock TextWrapping="Wrap" Text="這些設定通常不需要修改。錯誤設定可能讓系統無法讀取報名資料。" />
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Google 登入與試算表來源" />
            <Button Style="{StaticResource HelpButton}" CommandParameter="13" HorizontalAlignment="Left" Margin="-8,4,0,0" />
            <TextBlock Style="{StaticResource GroupTitle}" Text="試算表網址（Spreadsheet URL／ID）" />
            <TextBox Text="{Binding SpreadsheetInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="試算表網址"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <TextBlock Style="{StaticResource Hint}" Text="測試時請使用複製出來的測試試算表。修改後按上方「檢查連線」。" />

            <TextBlock Style="{StaticResource GroupTitle}" Text="OAuth 用戶端檔" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="選擇檔案…" Margin="8,0,0,0" Command="{Binding BrowseClientSecretCommand}" />
              <TextBox Text="{Binding ClientSecretPath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="OAuth 用戶端檔"
                       ToolTip="留白時使用隨程式發佈的 google-oauth-client.json" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="一般不需設定：留白時使用程式資料夾內的 google-oauth-client.json。授權只要求 Google Sheets 權限與帳號 Email；程式只操作上方設定的試算表。" />

            <Button Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Content="登出 Google" Margin="0,16,0,0" Command="{Binding SignOutCommand}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="欄位對應與管理資料區" />
            <TextBlock Style="{StaticResource GroupTitle}" Text="原始回應工作表" />
            <ComboBox ItemsSource="{Binding SourceSheets}" SelectedItem="{Binding SelectedSourceSheet}" AutomationProperties.Name="原始回應工作表" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="清單在按「檢查連線」後出現。程式以工作表編號記錄來源，分頁改名後仍可找到；請不要在原始回應頁排序、改標題或刪列。" />
            <WrapPanel Margin="0,14,0,0">
              <Button Content="建立管理資料區" Command="{Binding InitializeSchemaCommand}" Margin="0,0,8,8"
                      ToolTip="建立或補齊 _Config、_FieldMap、_Lookups、_Admin、_ChangeLog 分頁；不會修改原始回應" />
              <Button Content="顯示欄位檢查結果" Command="{Binding ShowHealthCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="管理資料區是同一份試算表中的 _Config、_FieldMap、_Lookups、_Admin、_ChangeLog 分頁。欄位名稱不一致時，請直接修改 _FieldMap。" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="原始資料與後台資料的對應" />
            <TextBlock Style="{StaticResource Hint}" Text="原始回應的時間戳記、Email 或電話被修改時，可能需要人工重新連結。" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="目前沒有需要處理的對應問題。"
                       Visibility="{Binding DataContext.SourceProblems.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding DataContext.SourceProblems, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                    <Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="｜" /><Run Text="{Binding RegistrationNo, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Message, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,10,0,0"
                  Visibility="{Binding DataContext.PendingRelinks.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="尚未連結的原始回應" />
                <ListBox Height="110" ItemsSource="{Binding DataContext.PendingRelinks, RelativeSource={RelativeSource AncestorType=Window}}"
                         DisplayMemberPath="Description" SelectedItem="{Binding DataContext.SelectedPendingRelink, RelativeSource={RelativeSource AncestorType=Window}}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="可能對應的後台資料" />
                <ListBox Height="110" ItemsSource="{Binding DataContext.SelectedPendingRelink.Candidates, RelativeSource={RelativeSource AncestorType=Window}}"
                         DisplayMemberPath="Description" SelectedItem="{Binding DataContext.SelectedRelinkCandidate, RelativeSource={RelativeSource AncestorType=Window}}" />
              </StackPanel>
              <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Margin="0,10,0,0" Content="重新連結"
                      Command="{Binding DataContext.RelinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="診斷資訊與日誌" />
            <TextBlock Style="{StaticResource Hint}" Text="需要協助時，建立診斷資料寄給管理員。內容已遮蔽姓名、Email、電話、統編與登入資訊。" />
            <WrapPanel Margin="0,12,0,0">
              <Button Content="建立診斷資料…" Command="{Binding CreateDiagnosticsPackageCommand}" Margin="0,0,8,8" />
              <Button Content="開啟日誌資料夾" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBox IsReadOnly="True" MinHeight="120" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" FontFamily="Consolas, Microsoft JhengHei UI"
                     FontSize="13" Text="{Binding DiagnosticsText, Mode=OneWay}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     AutomationProperties.Name="診斷結果" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
              <Run Text="日誌位置：" /><Run Text="{Binding LogDirectory, Mode=OneWay}" /><Run Text="（保留 14 天）" />
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}" Text="{Binding TechnicalVersionText}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,20,0,0">
        <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text="　·　需要協助時，請到「進階（管理員）」建立診斷資料。" />
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>

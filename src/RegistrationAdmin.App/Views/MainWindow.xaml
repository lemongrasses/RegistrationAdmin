<Window x:Class="RegistrationAdmin.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RegistrationAdmin.App.Views"
        xmlns:vm="clr-namespace:RegistrationAdmin.App.ViewModels"
        Title="活動報名後台"
        Width="1360" Height="840" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PageBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackToListCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ── 左側導航（固定 4 個入口） ── -->
    <Border Background="{StaticResource NavBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,22">
          <TextBlock Text="活動報名後台" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="報名資料處理" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0">
          <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource Muted}" FontSize="13" />
          <TextBlock Text="{Binding Settings.VersionText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
          <!-- 程式更新（DataContext 為 UpdateViewModel，於 MainWindow.xaml.cs 設定） -->
          <StackPanel x:Name="UpdatePanel" Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="-10,10,0,0"
                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ReadyText}">
              <StackPanel>
                <TextBlock Text="{Binding ReadyText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button Content="重新啟動並更新" Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding RestartToUpdateCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock FontSize="12" Margin="0,4,0,0"
                       Visibility="{Binding IsUpdateReady, Converter={StaticResource InverseBoolToVisibility}}">
              <Hyperlink Command="{Binding CheckCommand}" AutomationProperties.Name="檢查程式更新">檢查更新</Hyperlink>
            </TextBlock>
          </StackPanel>
        </StackPanel>

        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,16"
                     Content="設定" AutomationProperties.Name="設定"
                     IsChecked="{Binding Nav, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />

        <StackPanel KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="待處理" Tag="{Binding PendingBadge}"
                       AutomationProperties.Name="待處理"
                       ToolTip="需要審核、付款確認或有問題的報名"
                       IsChecked="{Binding Nav, Converter={StaticResource EnumEquals}, ConverterParameter=Pending}" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="全部名單" AutomationProperties.Name="全部名單"
                       IsChecked="{Binding Nav, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
          <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="匯出" AutomationProperties.Name="匯出"
                       IsChecked="{Binding Nav, Converter={StaticResource EnumEquals}, ConverterParameter=Export}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── 內容 ── -->
    <Grid Grid.Column="1">
      <views:RegistrationListView Visibility="{Binding IsListPage, Converter={StaticResource BoolToVisibility}}" x:Name="ListPage" />

      <ContentControl Content="{Binding Editor}" Focusable="False"
                      Visibility="{Binding IsDetailPage, Converter={StaticResource BoolToVisibility}}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="{x:Type vm:RegistrationEditorViewModel}">
            <views:RegistrationDetailView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <views:ExportView Visibility="{Binding IsExportPage, Converter={StaticResource BoolToVisibility}}" />

      <views:SettingsView DataContext="{Binding Settings}"
                          Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

      <!-- 忙碌與結果提示：不阻斷操作，浮在下方 -->
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" MaxWidth="760">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="10"
                Padding="16,10" Margin="0,0,0,8" Effect="{StaticResource CardShadow}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding BusyText}">
          <StackPanel Orientation="Horizontal">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource DividerBrush}"
                         BorderThickness="0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BusyText}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border x:Name="NoticeBar" CornerRadius="10" BorderThickness="1" Padding="16,10,8,10" Effect="{StaticResource CardShadow}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Notice}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource InfoBannerBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource InfoBannerBorderBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                  <Setter Property="Background" Value="{StaticResource SuccessBannerBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource SuccessBannerBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                  <Setter Property="Background" Value="{StaticResource WarningBannerBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource WarningBannerBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                  <Setter Property="Background" Value="{StaticResource ErrorBannerBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource ErrorBannerBorderBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="關閉" MinHeight="30" Margin="12,0,0,0"
                    Foreground="{StaticResource SecondaryTextBrush}" Command="{Binding CloseNoticeCommand}" />
            <TextBlock x:Name="NoticeIcon" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="i" />
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                      <Setter Property="Text" Value="✓" />
                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                      <Setter Property="Text" Value="!" />
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                      <Setter Property="Text" Value="!" />
                      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>

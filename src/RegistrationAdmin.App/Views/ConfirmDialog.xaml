<Window x:Class="RegistrationAdmin.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{StaticResource SurfaceBrush}" UseLayoutRounding="True">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" />
    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
               Foreground="{StaticResource SecondaryTextBrush}" />
    <StackPanel x:Name="ReasonPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ReasonLabel" Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="ReasonBox" TextWrapping="Wrap" TextChanged="OnReasonChanged" AutomationProperties.LabeledBy="{Binding ElementName=ReasonLabel}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" IsCancel="True" Content="取消" MinWidth="88" Margin="0,0,8,0" Click="OnCancel" />
      <Button x:Name="ConfirmButton" IsDefault="True" Content="確定" MinWidth="88" Style="{StaticResource PrimaryButton}" Click="OnConfirm" />
    </StackPanel>
  </Grid>
</Window>
